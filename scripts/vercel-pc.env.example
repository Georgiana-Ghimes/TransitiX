# Copiază ca scripts/vercel-pc.env (gitignored dacă pui secrete; tunnel name e ok în repo privat).
#
# Named tunnel (recomandat pentru echipă) — hostname stabil:
#   cloudflared tunnel login
#   cloudflared tunnel create transitix-api
#   cloudflared tunnel route dns transitix-api api.exemplu.ro
#   # config.yml: service http://127.0.0.1:3001
CLOUDFLARED_TUNNEL=Loki

# URL-ul public al FE (CORS e CLIENT_ORIGIN pe server)
# VERCEL_APP_URL=https://www.transitix.site
