# Copy to .env.companion for the RAI Spedition documents companion.
# Run UI: npm run dev:companion
# Run API: npm run dev --prefix server  (with server/companion.env.example copied to server/.env)

VITE_APP_PROFILE=documents
VITE_APP_TITLE=RAI Spedition — Documente
VITE_APP_TAGLINE=Companionul tău pentru documente
API_PORT=3002
# Optional: override git SHA shown as build (default = short commit hash)
# VITE_APP_BUILD=42
