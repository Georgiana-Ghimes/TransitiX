# Copy to .env next to docker-compose.yml before `docker compose up`

POSTGRES_DB=transitix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=schimba-parola-db

JWT_SECRET=schimba-jwt-secret-lung
CLIENT_ORIGIN=http://IP_SAU_DOMENIU_VM:8082

# Seed admin/sofer la primul start (1 = da, 0 = nu)
SEED_ON_START=1

# Port public pe VM (8080/8081 ocupate → Transitix pe 8082)
WEB_PORT=8082

# Opțional OCR
GOOGLE_VISION_API_KEY=

# Opțional email (Resend). Gol = log în consolă.
RESEND_API_KEY=
EMAIL_FROM=

