PORT=3001
# Docker Compose overlay maps host 5434 → container 5432. Native Postgres on 5432 is also fine.
DATABASE_URL=postgresql://postgres:password@localhost:5434/transitix

# Route tests (npm run test:api) run against this one and delete rows in it.
# The name must end in _test; the suite refuses anything else. Created automatically if missing.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5434/transitix_test
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Platform (GOD) admins — never commit real passwords. Bootstrap with:
#   PLATFORM_ADMIN_EMAILS=you@transitix.ro PLATFORM_ADMIN_BOOTSTRAP_PASSWORD='…' npm run platform:bootstrap --prefix server
# Re-run promotes existing emails; password is only used when creating a new user.
PLATFORM_ADMIN_EMAILS=
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

UPLOAD_DIR=uploads
CLIENT_ORIGIN=http://localhost:5173

# OSRM routing sidecar — real distances/durations (npm run osrm:prepare, then docker-compose.osrm.yml)
# Leave empty and /api/geo returns 503 instead of inventing a distance.
# Dev-only stopgap without Docker: https://router.project-osrm.org (public demo, rate-limited, never production data)
OSRM_URL=
OSRM_PROFILE=driving
# How long a measured distance stays valid in route_matrix_cache. Roads change slowly.
OSRM_MATRIX_TTL_DAYS=30

# VROOM solver sidecar — the route optimizer (docker-compose.vroom.yml)
# Leave empty and the optimizer returns 503 instead of a plan nobody solved.
# It never calls OSRM itself; the API hands it a matrix from the cache.
VROOM_URL=
# How long the solver may think before answering. The dispatcher is waiting.
VROOM_TIME_LIMIT_SEC=30

# Photon geocoder — turns addresses into coordinates (npm run db:geocode:locations)
# Leave empty and geocoding is disabled rather than guessing a pin.
# Dev-only stopgap: https://photon.komoot.io (public instance, rate-limited, no real client data)
PHOTON_URL=

# TomTom Search — escalation for addresses Photon cannot resolve (billed per request).
# Left empty, geocoding stays on Photon alone. Setting it changes the cache strategy label,
# which re-runs exactly the weak addresses through the better provider.
TOMTOM_API_KEY=

# Behind a tunnel or reverse proxy? Then the client's scheme and address arrive in
# X-Forwarded-*. Leave this off when nothing sits in front: trusting those headers directly
# lets any client claim any address.
# TRUST_PROXY=1

# Local OCR sidecar (PaddleOCR via Docker). Preferred for photos when running locally.
# Start: docker compose -f docker-compose.paddle-ocr.yml up -d --build
# OCR_PROVIDER=paddle|none  (empty = auto: paddle when PADDLE_OCR_URL is set, else none)
OCR_PROVIDER=paddle
PADDLE_OCR_URL=http://127.0.0.1:8100
# PADDLE_OCR_LANG=latin
# How long an OCR call may take. Background extraction waits out a slow CPU VM; the
# re-extract button gives up early so the screen does not hang.
# OCR_TIMEOUT_MS=300000
# OCR_INTERACTIVE_TIMEOUT_MS=45000
# Documents longer than this extract in the background instead of holding the request open.
# OCR_INTERACTIVE_MAX_PAGES=3
# Pages the sidecar will rasterize from one PDF. Anything beyond is reported, never dropped
# silently — set on the paddle-ocr service, not here.
# PADDLE_OCR_PDF_PAGES=40

# Resend — aviz annex + password reset (optional; otherwise emails are logged)
RESEND_API_KEY=
EMAIL_FROM=

# e-Transport UIT on route launch: stub (default, local RO+hash) | off
# Real ANAF SPV wiring comes later — do not pretend credentials exist.
ETRANSPORT_MODE=stub

# e-Transport (UIT). Modes:
#   off   - do not request a code at all
#   stub  - local placeholder for development; codes are prefixed STUB- and are NOT valid
#   anaf  - request real codes from ANAF; fails loudly if the credentials below are missing
ETRANSPORT_MODE=stub
ANAF_ETRANSPORT_URL=
ANAF_ETRANSPORT_TOKEN=

# Housekeeping. The tables that take a row per GPS ping grow without limit otherwise.
# Nothing that records what we sent a customer, or what a person did, is ever pruned:
# aviz_export_log, document_events, trip_charges, invoice_lines, delivery_proofs and
# trip_documents are on an explicit protected list in lib/maintenance/retention.js.
RETENTION_ENABLED=true
RETENTION_INTERVAL_HOURS=24

# Per-policy windows, in days. Leave unset to use the defaults shown.
# A value that is not a positive number is ignored rather than obeyed — a literal 0 would
# mean "older than now", i.e. the whole table.
RETAIN_TELEMATICS_POSITIONS_DAYS=90
RETAIN_GPS_LOGS_DAYS=30
RETAIN_CHAT_MESSAGES_DAYS=365
RETAIN_OFFICE_NOTIFICATION_DISMISSALS_DAYS=180
RETAIN_REFRESH_TOKENS_DAYS=30
# Long on purpose: dropping a cached geocode costs a paid lookup to get it back.
RETAIN_GEOCODE_CACHE_DAYS=730
