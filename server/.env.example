PORT=3001
# Docker Compose overlay maps host 5434 → container 5432. Native Postgres on 5432 is also fine.
DATABASE_URL=postgresql://postgres:password@localhost:5434/transitix
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
CLIENT_ORIGIN=http://localhost:5173

# OSRM routing sidecar — real distances/durations (npm run osrm:prepare, then docker-compose.osrm.yml)
# Leave empty and /api/geo returns 503 instead of inventing a distance.
# Dev-only stopgap without Docker: https://router.project-osrm.org (public demo, rate-limited, never production data)
OSRM_URL=
OSRM_PROFILE=driving

# Photon geocoder — turns addresses into coordinates (npm run db:geocode:locations)
# Leave empty and geocoding is disabled rather than guessing a pin.
# Dev-only stopgap: https://photon.komoot.io (public instance, rate-limited, no real client data)
PHOTON_URL=

# Google Cloud Vision — CMR / aviz images (optional; PDFs with text layer work without it)
GOOGLE_VISION_API_KEY=

# Resend — aviz annex + password reset (optional; otherwise emails are logged)
RESEND_API_KEY=
EMAIL_FROM=
