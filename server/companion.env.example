PORT=3002
# Isolated Postgres from docker-compose.companion.yml (host 5435).
DATABASE_URL=postgresql://postgres:password@localhost:5435/transitix_rai

JWT_SECRET=schimba-jwt-secret-companion-rai
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
# Relative to the server/ cwd when you run `npm run dev --prefix server`.
UPLOAD_DIR=uploads
# The public hostname the tunnel serves, with its scheme. Same origin as the API, because
# `npm run start:companion` has the API serve the built frontend too.
CLIENT_ORIGIN=https://documente.exemplu.ro
# The tunnel is the proxy in front — without this the app sees its address, not the client's,
# and never learns the connection was HTTPS.
TRUST_PROXY=1

OCR_PROVIDER=paddle
PADDLE_OCR_URL=http://127.0.0.1:8101
# Paddle on this VM is CPU-only; the re-extract button must not hang on it.
# OCR_TIMEOUT_MS=300000
# OCR_INTERACTIVE_TIMEOUT_MS=45000
# OCR_INTERACTIVE_MAX_PAGES=3

# Independent from the main Transitix instance — do not reuse its JWT_SECRET or DATABASE_URL.
