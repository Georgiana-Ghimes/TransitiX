# Marks this file as the companion overlay (loadEnv peeks this if shell unset COMPANION).
COMPANION=1
PORT=3002
# Isolated Postgres from docker-compose.companion.yml (host 5435).
DATABASE_URL=postgresql://postgres:password@localhost:5435/transitix_rai

JWT_SECRET=schimba-jwt-secret-companion-rai
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
# Stable public URL for invite / reset / verify links (and CORS).
# Prod companion: https://rai-transitix.filumforge.ro
# Optional: PUBLIC_APP_ORIGIN=… if CLIENT_ORIGIN also lists a trycloudflare tunnel.
CLIENT_ORIGIN=https://rai-transitix.filumforge.ro
# PUBLIC_APP_ORIGIN=https://rai-transitix.filumforge.ro
TRUST_PROXY=1

RESEND_API_KEY=
EMAIL_FROM=
ALLOW_SIGNUP=true
# Feature flag: false ascunde butonul Google pe Login/Register chiar dacă GOOGLE_CLIENT_ID e setat.
ALLOW_GOOGLE_SIGNIN=false
GOOGLE_CLIENT_ID=

# Mistral Document AI OCR (cloud). No local OCR containers.
OCR_PROVIDER=mistral
MISTRAL_API_KEY=

# GOD panel (separate from tenant admin@…). Bootstrap against companion DB:
#   COMPANION=1 PLATFORM_ADMIN_EMAILS=platformadmin@transitix.ro PLATFORM_ADMIN_BOOTSTRAP_PASSWORD='…' npm run platform:bootstrap --prefix server
# Rotate existing GOD password (does nothing without RESET=1 — re-bootstrap alone never changes hash):
#   COMPANION=1 PLATFORM_ADMIN_RESET_PASSWORD=1 PLATFORM_ADMIN_EMAILS=platformadmin@transitix.ro PLATFORM_ADMIN_BOOTSTRAP_PASSWORD='…' npm run platform:bootstrap --prefix server
# PLATFORM_ADMIN_EMAILS=platformadmin@transitix.ro
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=
# Copy this file to server/.env.companion (gitignored) and set the key.
# Start API with: npm run dev:companion-api  (sets COMPANION=1 → loads .env.companion)
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_CHAT_MODEL=mistral-small-latest
# After OCR: LLM picks Expeditor vs Adresa de livrare (set 0 to keep regex-only routes)
# Route = labels + columns only (no LLM). AVIZ_SEMANTIC_ADDRESSES ignored.
# OCR_TIMEOUT_MS=300000
# OCR_INTERACTIVE_TIMEOUT_MS=120000
# OCR_INTERACTIVE_MAX_PAGES=3
# OCR_CONCURRENCY=2
