PORT=3002
# Isolated Postgres from docker-compose.companion.yml (host 5435).
DATABASE_URL=postgresql://postgres:password@localhost:5435/transitix_rai

JWT_SECRET=schimba-jwt-secret-companion-rai
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
CLIENT_ORIGIN=https://documente.exemplu.ro
TRUST_PROXY=1

RESEND_API_KEY=
EMAIL_FROM=
ALLOW_SIGNUP=true
GOOGLE_CLIENT_ID=

# Mistral Document AI OCR (cloud). No local OCR containers.
OCR_PROVIDER=mistral
MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# OCR_TIMEOUT_MS=300000
# OCR_INTERACTIVE_TIMEOUT_MS=120000
# OCR_INTERACTIVE_MAX_PAGES=3
# OCR_CONCURRENCY=2
