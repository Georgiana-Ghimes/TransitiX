PORT=3001
# Docker Compose overlay maps host 5434 → container 5432. Native Postgres on 5432 is also fine.
DATABASE_URL=postgresql://postgres:password@localhost:5434/transitix
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=uploads
CLIENT_ORIGIN=http://localhost:5173
# For the RAI companion locally, prefer both hosts (CORS + Google JS origins):
# CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Google Cloud Vision — CMR / aviz images (optional; PDFs with text layer work without it)
GOOGLE_VISION_API_KEY=

# Resend — aviz annex, password reset, invitations, sign-up verification.
# Optional: without it emails are only logged and the links are shown on screen instead.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Transitix <no-reply@firma.ro>".
RESEND_API_KEY=
EMAIL_FROM=

# Account sign-up and sign-in
# ALLOW_SIGNUP=false keeps new companies out (accounts only by invitation). Default: open.
ALLOW_SIGNUP=true
# Google sign-in (not Firebase): OAuth 2.0 "Web application" Client ID
# (….apps.googleusercontent.com). List every CLIENT_ORIGIN host under Authorized JavaScript origins
# (e.g. http://localhost:5174 and http://127.0.0.1:5174). Empty = Google button hidden.
GOOGLE_CLIENT_ID=
