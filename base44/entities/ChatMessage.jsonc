{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_role": {
      "type": "string",
      "enum": [
        "driver",
        "dispatcher"
      ],
      "default": "driver",
      "title": "Rol expeditor"
    },
    "sender_name": {
      "type": "string",
      "title": "Nume expeditor"
    },
    "message": {
      "type": "string",
      "title": "Mesaj"
    },
    "trip_id": {
      "type": "string",
      "title": "Curs\u0103"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "title": "Citit"
    }
  },
  "required": [
    "sender_role",
    "message"
  ]
}