{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "plate": {
      "type": "string",
      "title": "Num\u0103r \u00eenmatriculare"
    },
    "brand": {
      "type": "string",
      "title": "Marc\u0103"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "year": {
      "type": "integer",
      "title": "An fabrica\u021bie"
    },
    "capacity_kg": {
      "type": "integer",
      "title": "Capacitate (kg)"
    },
    "capacity_mc": {
      "type": "integer",
      "title": "Capacitate (mc)"
    },
    "fuel_consumption": {
      "type": "number",
      "title": "Consum normat (l/100km)"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "gasoline",
        "electric",
        "hybrid"
      ],
      "default": "diesel",
      "title": "Tip combustibil"
    },
    "chassis_number": {
      "type": "string",
      "title": "Num\u0103r \u0219asiu"
    },
    "engine_number": {
      "type": "string",
      "title": "Num\u0103r motor"
    },
    "mileage": {
      "type": "integer",
      "default": 0,
      "title": "Kilometraj"
    },
    "last_maintenance_mileage": {
      "type": "integer",
      "default": 0,
      "title": "Km la ultima mentenan\u021b\u0103"
    },
    "itp_number": {
      "type": "string",
      "title": "Num\u0103r ITP"
    },
    "itp_expiry": {
      "type": "string",
      "format": "date",
      "title": "Expirare ITP"
    },
    "rca_number": {
      "type": "string",
      "title": "Num\u0103r RCA"
    },
    "rca_expiry": {
      "type": "string",
      "format": "date",
      "title": "Expirare RCA"
    },
    "rovinieta_number": {
      "type": "string",
      "title": "Num\u0103r roviniet\u0103"
    },
    "rovinieta_expiry": {
      "type": "string",
      "format": "date",
      "title": "Expirare roviniet\u0103"
    },
    "casco_number": {
      "type": "string",
      "title": "Num\u0103r CASCO"
    },
    "casco_expiry": {
      "type": "string",
      "format": "date",
      "title": "Expirare CASCO"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Activ"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "in_trip",
        "maintenance",
        "inactive"
      ],
      "default": "available",
      "title": "Status"
    }
  },
  "required": [
    "plate",
    "brand",
    "model"
  ]
}