{
  "name": "Trip",
  "type": "object",
  "properties": {
    "cmr_number": {
      "type": "string",
      "title": "Num\u0103r CMR"
    },
    "driver_id": {
      "type": "string",
      "title": "\u0218ofer"
    },
    "driver_name": {
      "type": "string",
      "title": "Nume \u0219ofer"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehicul"
    },
    "vehicle_plate": {
      "type": "string",
      "title": "Num\u0103r vehicul"
    },
    "shipper_name": {
      "type": "string",
      "title": "Expeditor"
    },
    "shipper_address": {
      "type": "string",
      "title": "Adres\u0103 expeditor"
    },
    "shipper_contact": {
      "type": "string",
      "title": "Contact expeditor"
    },
    "shipper_phone": {
      "type": "string",
      "title": "Telefon expeditor"
    },
    "consignee_name": {
      "type": "string",
      "title": "Destinatar"
    },
    "consignee_address": {
      "type": "string",
      "title": "Adres\u0103 destinatar"
    },
    "consignee_contact": {
      "type": "string",
      "title": "Contact destinatar"
    },
    "consignee_phone": {
      "type": "string",
      "title": "Telefon destinatar"
    },
    "loading_date": {
      "type": "string",
      "format": "date",
      "title": "Data \u00eenc\u0103rc\u0103rii"
    },
    "loading_time": {
      "type": "string",
      "title": "Ora \u00eenc\u0103rc\u0103rii"
    },
    "estimated_delivery_date": {
      "type": "string",
      "format": "date",
      "title": "Data estimat\u0103 livrare"
    },
    "estimated_delivery_time": {
      "type": "string",
      "title": "Ora estimat\u0103 livrare"
    },
    "actual_delivery_date": {
      "type": "string",
      "format": "date",
      "title": "Data livr\u0103rii reale"
    },
    "goods_description": {
      "type": "string",
      "title": "Descriere marf\u0103"
    },
    "weight_kg": {
      "type": "number",
      "title": "Greutate (kg)"
    },
    "package_count": {
      "type": "integer",
      "title": "Num\u0103r colete"
    },
    "volume_mc": {
      "type": "number",
      "title": "Volum (mc)"
    },
    "special_instructions": {
      "type": "string",
      "title": "Instruc\u021biuni speciale"
    },
    "internal_notes": {
      "type": "string",
      "title": "Note interne"
    },
    "status": {
      "type": "string",
      "enum": [
        "planificata",
        "alocata",
        "incarcata",
        "in_tranzit",
        "livrata",
        "problema",
        "anulata"
      ],
      "default": "planificata",
      "title": "Status"
    },
    "distance_km": {
      "type": "integer",
      "title": "Distan\u021b\u0103 (km)"
    },
    "estimated_fuel_consumption": {
      "type": "number",
      "title": "Consum estimat (l)"
    },
    "actual_fuel_consumption": {
      "type": "number",
      "title": "Consum real (l)"
    },
    "start_mileage": {
      "type": "integer",
      "title": "Km start"
    },
    "end_mileage": {
      "type": "integer",
      "title": "Km final"
    }
  },
  "required": [
    "shipper_name",
    "consignee_name",
    "loading_date"
  ]
}